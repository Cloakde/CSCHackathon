# Server-only provider credentials. Never prefix these with NEXT_PUBLIC_.
ELEVENLABS_API_KEY=
GENERATION_API_KEY=

# The demo launcher sets these server-only values; no .env file is needed.
LIVELECTURE_DEMO_ENABLED=false
# Optional exact Chrome extension ID; pass --extension-id=... to the launcher.
LIVELECTURE_EXTENSION_ID=
# Demo origin is fixed to http://127.0.0.1:3000. Do not expose it publicly.

# TASK-102 — the ElevenLabs realtime-token route. scripts/manual/
# run-local-scribe-spike.mjs sets these in its own child-process environment;
# no .env file is needed or read for the paid spike itself. Kept here only so
# the required variable names are documented in one place. The route stays
# disabled unless LIVE_SCRIBE_SPIKE_ENABLED is exactly "true".
LIVE_SCRIBE_SPIKE_ENABLED=false
LIVELECTURE_SPIKE_CAPABILITY=
